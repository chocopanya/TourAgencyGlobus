<Window x:Class="TourAgencyGlobus.Views.ApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Заявки на туры" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="dgApplications" 
                  AutoGenerateColumns="True" IsReadOnly="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить" Width="80" Height="30" Margin="5"
                    Click="BtnRefresh_Click"/>
            <Button Content="Закрыть" Width="80" Height="30" Margin="5"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>