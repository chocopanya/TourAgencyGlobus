<Window x:Class="TourAgencyGlobus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TourAgencyGlobus"
        Title="Турагентство 'Глобус'" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <local:BoolToSpecialConverter x:Key="BoolToSpecialConverter"/>

        <Style x:Key="TourCardStyle" TargetType="Border">
            <Style.Triggers>
                <!-- Спецпредложение (скидка >15%) -->
                <DataTrigger Binding="{Binding IsSpecialOffer}" Value="True">
                    <Setter Property="Background" Value="#FFD700"/>
                </DataTrigger>

                <!-- Мало мест (<10%) -->
                <DataTrigger Binding="{Binding IsFewSeats}" Value="True">
                    <Setter Property="Background" Value="#FFB6C1"/>
                </DataTrigger>

                <!-- Тур скоро начнется (<7 дней) -->
                <DataTrigger Binding="{Binding IsStartingSoon}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Турагентство 'Глобус'" 
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtUserInfo" Text="Гость" 
                           Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button x:Name="btnLogout" Content="Выйти" 
                        Width="80" Height="30" 
                        Background="#1976D2" Foreground="White"
                        FontWeight="Bold"
                        Margin="20,0,0,0"
                        Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- ListView с турами (как на фото 2) -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icTours" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" 
                                CornerRadius="5" Margin="10"
                                Width="250" Height="350"
                                Style="{StaticResource TourCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Фото тура -->
                                <Image Grid.Row="0" 
                                       Source="{Binding PhotoFileName, Converter={StaticResource ImagePathConverter}}"
                                       Stretch="UniformToFill"
                                       Width="250" Height="150"/>

                                <!-- Название -->
                                <TextBlock Grid.Row="1" Text="{Binding Name}" 
                                           FontWeight="Bold" FontSize="14"
                                           Margin="5,5,5,2"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>

                                <!-- Страна -->
                                <TextBlock Grid.Row="2" 
                                           Text="{Binding Country.Name}"
                                           FontSize="12" Foreground="#666666"
                                           Margin="5,0,5,2"
                                           TextAlignment="Center"/>

                                <!-- Продолжительность -->
                                <TextBlock Grid.Row="3" 
                                           Text="{Binding Duration, StringFormat='Продолжительность: {0} дней'}"
                                           FontSize="12"
                                           Margin="5,0,5,2"
                                           TextAlignment="Center"/>

                                <!-- Дата начала -->
                                <TextBlock Grid.Row="4" 
                                           Text="{Binding StartDate, StringFormat='Дата начала: {0:dd.MM.yyyy}'}"
                                           FontSize="12"
                                           Margin="5,0,5,2"
                                           TextAlignment="Center"/>

                                <!-- Базовая стоимость -->
                                <TextBlock Grid.Row="5" 
                                           Text="{Binding Price, StringFormat='Базовая стоимость: {0:N0} руб.'}"
                                           FontSize="12"
                                           Margin="5,0,5,2"
                                           TextAlignment="Center"/>

                                <!-- Скидка -->
                                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Размер скидки: " FontSize="12"/>
                                    <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}" 
                                               FontSize="12" FontWeight="Bold" Foreground="Red"/>
                                </StackPanel>

                                <!-- Свободные места -->
                                <TextBlock Grid.Row="7" 
                                           Text="{Binding FreeSeats, StringFormat='Свободных мест: {0}/{1}'}"
                                           FontSize="12"
                                           Margin="5,0,5,2"
                                           TextAlignment="Center"/>

                                <!-- Статус "Скоро" если тур скоро начинается -->
                                <TextBlock Grid.Row="8" 
                                           Text="{Binding IsStartingSoon, Converter={StaticResource BoolToStatusConverter}}"
                                           FontSize="12" FontWeight="Bold" Foreground="Red"
                                           Margin="5,5,5,5"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding IsStartingSoon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Панель управления для менеджера -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
            <StackPanel x:Name="ManagerPanel" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="btnAddTour" Content="Добавить тур" 
                        Width="120" Height="35" Margin="5"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        Click="BtnAddTour_Click"/>

                <Button x:Name="btnEditTour" Content="Редактировать" 
                        Width="120" Height="35" Margin="5"
                        Background="#2196F3" Foreground="White" FontWeight="Bold"
                        Click="BtnEditTour_Click"/>

                <Button x:Name="btnDeleteTour" Content="Удалить" 
                        Width="100" Height="35" Margin="5"
                        Background="#F44336" Foreground="White" FontWeight="Bold"
                        Click="BtnDeleteTour_Click"/>

                <Button x:Name="btnApplications" Content="Заявки" 
                        Width="100" Height="35" Margin="5"
                        Background="#FF9800" Foreground="White" FontWeight="Bold"
                        Click="BtnApplications_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>